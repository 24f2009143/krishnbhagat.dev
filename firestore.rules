rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, email verified by Google, and an IITM student address.
    function student() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@ds[.]study[.]iitm[.]ac[.]in');
    }
    // The site owner can read everyone's progress (to improve the sites). Nobody else can.
    function owner() {
      return student() && request.auth.token.email == '24f2009143@ds.study.iitm.ac.in';
    }
    function validDoc(extraKeys) {
      return request.resource.data.keys().hasOnly(['state', 'updatedAt', 'email'].concat(extraKeys))
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000
        && request.resource.data.email == request.auth.token.email;
    }

    // MLT site
    match /users/{uid} {
      allow read: if student() && request.auth.uid == uid;
      allow read: if owner();
      allow create, update: if student() && request.auth.uid == uid && validDoc(['epoch']);
      allow delete: if student() && request.auth.uid == uid;
    }

    // PDSA site
    match /pdsa/{uid} {
      allow read: if student() && request.auth.uid == uid;
      allow read: if owner();
      allow create, update: if student() && request.auth.uid == uid && validDoc([]);
      allow delete: if student() && request.auth.uid == uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
